# ==============================================
# MinerU 服务配置
# ==============================================

# Docker 镜像版本
MINERU_IMAGE=zxwei/mineru-api-full:v2.5.4

# 服务端口配置
MINERU_API_PORT=8000          # MinerU API 服务端口
MINERU_VLLM_PORT=30000        # MinerU VLM 服务端口（可选）

# GPU 配置
# 单卡示例: MINERU_GPU_DEVICE_IDS=0
# 多卡示例: MINERU_GPU_DEVICE_IDS=0,1,2
MINERU_GPU_DEVICE_IDS=0

# 模型配置
MINERU_MODEL_SOURCE=local     # 模型来源: local（预下载）, huggingface
MINERU_MODELS_PRELOADED=true  # 镜像是否预下载模型

# 时区
TIMEZONE=Asia/Shanghai
