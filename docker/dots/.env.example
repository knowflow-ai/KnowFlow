# ==============================================
# DOTS OCR 服务配置
# ==============================================

# Docker 镜像版本
DOTS_IMAGE=rednotehilab/dots.ocr:vllm-openai-v0.9.1

# 服务端口
DOTS_PORT=8000

# GPU 配置
# 单卡示例: DOTS_GPU_DEVICE_IDS=0
# 多卡示例: DOTS_GPU_DEVICE_IDS=0,1
DOTS_GPU_DEVICE_IDS=0

# 模型路径（需要提前下载模型到此目录）
# 模型下载地址: https://www.modelscope.cn/models/rednote-hilab/dots.ocr
# 下载后的目录结构应为: weights/DotsOCR/
DOTS_MODEL_DIR=./weights/DotsOCR

# 模型名称
DOTS_MODEL_NAME=dotsocr-model

# vLLM 配置
DOTS_TENSOR_PARALLEL_SIZE=1        # 张量并行大小（GPU 数量）
DOTS_GPU_MEMORY_UTILIZATION=0.8    # GPU 内存利用率 (0.0-1.0)

# 时区
TIMEZONE=Asia/Shanghai
