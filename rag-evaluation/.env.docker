# =======================================================
# RAG 评估系统 Docker 环境配置
# =======================================================

# 服务配置
DEBUG=FALSE
HOST=0.0.0.0
PORT=5002
SECRET_KEY=rag-evaluation-secret-key-change-in-production

# RAGFlow 配置
# 部署时请修改 RAGFLOW_BASE_URL 为服务器的实际 IP 地址
# 例如: http://192.168.1.100:9380
RAGFLOW_BASE_URL=http://YOUR_SERVER_IP:9380
RAGFLOW_API_KEY=ragflow-your-api-key

# 硅基流动配置 (默认 LLM 提供商)
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# OpenAI 配置
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek 配置
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 智谱AI配置
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 默认模型配置
DEFAULT_LLM_PROVIDER=siliconflow
DEFAULT_LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3

# 评测配置
EVALUATION_TIMEOUT=300
EVALUATION_MAX_WORKERS=2
EVALUATION_MAX_RETRIES=2

# 文件存储配置
TEMP_DIR=/app/tmp
DATASETS_DIR=/app/tmp/datasets
REPORTS_DIR=/app/tmp/evaluation/reports

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/app/logs/evaluation.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# 安全配置
MAX_CONTENT_LENGTH=104857600
CORS_ORIGINS=*
